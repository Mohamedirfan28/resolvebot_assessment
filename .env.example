# Copy this file to .env and fill in what you need.
# Every value below is also read straight from the environment.

# Paths (defaults point at ./data)
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db

# The date the business logic must treat as "today". Never uses the machine clock.
APP_TODAY=2026-07-01

# LLM settings. The assistant works without an LLM (deterministic planner).
# Optional: set a provider to let the model rephrase final `answer` text.
# Values: none | openai | anthropic | google
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
# 0 = deterministic planner (default). 1 = real LLM tool loop (needs a provider key).
LLM_AGENT=0
# Optional: rephrase final answers with the LLM when the agent loop is off.
LLM_POLISH=0

# Provider keys (only the one you use is needed). Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
MAX_TOOL_CALLS=6

# Logging
LOG_LEVEL=INFO
