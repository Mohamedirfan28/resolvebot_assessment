# Paths. All defaults point at the supplied ./data folder.
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db

# Treat this as "today" instead of the machine clock.
APP_TODAY=2026-07-01

# Optional LLM. Use none for the deterministic planner (the default).
# Allowed providers: none, openai, anthropic, google
LLM_PROVIDER=none
# auto: use the LLM when a provider and key are configured.
# always: require it (still falls back to the deterministic planner on provider errors).
# never: always use the deterministic planner.
LLM_AGENT=auto
# Leave blank to use the provider default model.
LLM_MODEL=
# Optional custom OpenAI-compatible base URL.
LLM_BASE_URL=
# The key is read from <PROVIDER>_API_KEY, for example OPENAI_API_KEY.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Generic fallback key name if your deployment prefers it.
LLM_API_KEY=
# Optionally polish deterministic replies with the configured LLM.
LLM_POLISH=false

# Server and limits.
HOST=0.0.0.0
PORT=8000
MAX_TOOL_CALLS=6
LOG_LEVEL=INFO
